   "source": [
    "import tensorflow as tf\n",
    "import matplotlib.pyplot as plt\n",
    "from tensorflow.keras.datasets import mnist\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Input, Flatten, Dense\n",
    "from tensorflow.keras.applications import VGG19\n",
    "from tensorflow.keras.applications.vgg19 import preprocess_input\n",
    "from tensorflow.keras.utils import to_categorical\n",
    "\n",
    "# Apply dark mode styling to the generated matplotlib plots\n",
    "plt.style.use('dark_background')\n",
    "\n",
    "# Load and preprocess data subsets\n",
    "(xtr_raw, ytr_raw), (xte_raw, yte_raw) = mnist.load_data()\n",
    "\n",
    "xtr, ytr = xtr_raw[:1500], ytr_raw[:1500]\n",
    "xte, yte = xte_raw[:500], yte_raw[:500]\n",
    "\n",
    "ytr, yte = to_categorical(ytr), to_categorical(yte)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build simple neural network\n",
    "model = Sequential([\n",
    "    Input(shape=(28, 28)),\n",
    "    Flatten(),\n",
    "    Dense(256, activation='relu'),\n",
    "    Dense(10, activation='softmax')\n",
    "])\n",
    "\n",
    "model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "# Train simple neural network\n",
    "h1 = model.fit(\n",
    "    xtr / 255.0, ytr,\n",
    "    epochs=5,\n",
    "    batch_size=64,\n",
    "    validation_split=0.2\n",
    ")\n",
    "\n",
    "# Evaluate simple neural network\n",
    "loss, acc = model.evaluate(xte / 255.0, yte)\n",
    "print('Simple NN Test Accuracy:', round(acc * 100, 2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert grayscale images to RGB and resize for VGG19 input size requirements\n",
    "xtr_vgg = tf.image.resize(\n",
    "    tf.image.grayscale_to_rgb(xtr[..., None]),\n",
    "    (224, 224)\n",
    ")\n",
    "\n",
    "xte_vgg = tf.image.resize(\n",
    "    tf.image.grayscale_to_rgb(xte[..., None]),\n",
    "    (224, 224)\n",
    ")\n",
    "\n",
    "# Apply VGG19 preprocessing\n",
    "xtr_vgg, xte_vgg = preprocess_input(xtr_vgg), preprocess_input(xte_vgg)\n",
    "\n",
    "# Load and freeze pretrained VGG19 base layers\n",
    "base = VGG19(\n",
    "    weights='imagenet',\n",
    "    include_top=False,\n",
    "    input_shape=(224, 224, 3)\n",
    ")\n",
    "base.trainable = False\n",
    "\n",
    "# Build VGG19-based network\n",
    "model2 = Sequential([\n",
    "    base,\n",
    "    Flatten(),\n",
    "    Dense(256, activation='relu'),\n",
    "    Dense(10, activation='softmax')\n",
    "])\n",
    "\n",
    "model2.compile(\n",
    "    optimizer='adam',\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "# Train custom classifier layer over VGG19 features\n",
    "h2 = model2.fit(\n",
    "    xtr_vgg, ytr,\n",
    "    epochs=5,\n",
    "    batch_size=64,\n",
    "    validation_split=0.2\n",
    ")\n",
    "\n",
    "# Evaluate VGG19-based model\n",
    "loss, acc = model2.evaluate(xte_vgg, yte)\n",
    "print('VGG19 Test Accuracy:', round(acc * 100, 2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare training and validation accuracy across architectures\n",
    "plt.figure(figsize=(10, 6))\n",
    "for h, name in [(h1, 'Simple NN'), (h2, 'VGG19')]:\n",
    "    plt.plot(h.history['accuracy'], label=name + ' Train', linestyle='-')\n",
    "    plt.plot(h.history['val_accuracy'], label=name + ' Validation', linestyle='--')\n",
    "\n",
    "plt.title('Architecture Performance Comparison (MNIST Subset)')\n",
    "plt.xlabel('Epochs')\n",
    "plt.ylabel('Accuracy')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.2)\n",
    "plt.show()"
   ]
  }
 ],
